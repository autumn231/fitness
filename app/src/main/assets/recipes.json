    {
     "foodId": "012401x",
     "gram": 250,
     "note": "约一碗半"
    },
    {
     "foodId": "045217",
     "gram": 150,
     "note": "掰小朵"
    }
   ],
   "steps": [
    "鸡胸肉切片，加盐、黑胡椒、生抽少许腌制 10 分钟。",
